---
import { getCollection, type CollectionKey } from 'astro:content';

interface Props {
  collection: CollectionKey;
  exclude?: string | string[];
  sortBy?: string;
  filterPrefix?: string;
  filterConcept?: string;
}

const { collection, exclude, sortBy = 'title', filterPrefix, filterConcept } = Astro.props;

const excludeList = Array.isArray(exclude)
  ? exclude
  : exclude
    ? [exclude]
    : [];

const collectionFolderRegex = /^(docs\/)?(lorelog|mascots|releases|changelog|haikus|limericks|aphorisms|reference|guides|posts)\//;

const entries = (await getCollection(collection as any, (e: any) => {
  // ─── CRITICAL FIX: Symmetrical Prefix Normalization ───
  if (filterPrefix) {
    const idLower = e.id.toLowerCase();
    const prefixLower = filterPrefix.toLowerCase();
    const filename = idLower.split('/').pop() || '';
    
    // Strip leading collection folders and format headers to align matches
    const cleanId = idLower
      .replace(collectionFolderRegex, '')
      .replace(/^(hai|lim|aph)-/, '');
      
    const cleanPrefix = prefixLower
      .replace(collectionFolderRegex, '')
      .replace(/^(hai|lim|aph)-/, '');

    const matchClean = cleanPrefix.length > 0 && cleanId.startsWith(cleanPrefix);

    if (
      !idLower.startsWith(prefixLower) && 
      !filename.startsWith(prefixLower) && 
      !matchClean
    ) {
      return false;
    }
  }

  if (filterConcept && (!e.data.concepts || !e.data.concepts.includes(filterConcept))) return false;

  if (excludeList.length > 0) {
    const slug = e.id.split('/').pop()?.replace(/\.mdx?$/, '');
    if ((slug && excludeList.includes(slug)) || excludeList.includes(e.id)) {
      return false;
    }
  }

  return true;
}))
  .sort((a: any, b: any) => {
    const hasA = a.data.mascotId != null;
    const hasB = b.data.mascotId != null;

    if (collection === 'mascots' || filterPrefix?.startsWith('mascots')) {
      if (hasA && !hasB) return -1;
      if (!hasA && hasB) return 1;
      if (hasA && hasB) return Number(a.data.mascotId) - Number(b.data.mascotId);

      const ta = a.data.displayName ?? a.data.title ?? '';
      const tb = b.data.displayName ?? b.data.title ?? '';
      return ta.localeCompare(tb);
    }

    const va = a.data[sortBy] ?? a.data.title ?? '';
    const vb = b.data[sortBy] ?? b.data.title ?? '';

    if (va instanceof Date) return vb.valueOf() - va.valueOf();

    const na = Number(va);
    const nb = Number(vb);
    if (!isNaN(na) && !isNaN(nb)) return na - nb;

    return String(va).localeCompare(String(vb));
  });

// Resolving Parent Hrefs for Poems
import { resolveExactAlias, entryHref, type ArchiveEntry } from '../lib/archive-identity';

const isPoetryCollection = ['haikus', 'limericks', 'aphorisms'].includes(collection);

let allEntries: ArchiveEntry[] = [];
const poemToLorelogMap = new Map<string, string>();

if (isPoetryCollection) {
  const [mascots, lorelogs, docs] = await Promise.all([
    getCollection('mascots'),
    getCollection('lorelog'),
    getCollection('docs'),
  ]);

  allEntries = [
    ...mascots.map((e) => ({ ...e, collection: 'mascots' })),
    ...lorelogs.map((e) => ({ ...e, collection: 'lorelog' })),
    ...docs.map((e) => ({ ...e, collection: 'docs' })),
  ];

  for (const lg of lorelogs) {
    const lgName = lg.id.replace(/\.mdx?$/, '');
    
    const relatedH = (lg.data as any).relatedHaiku || [];
    for (const h of relatedH) {
      if (h.slug) {
        const hName = h.slug.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
        poemToLorelogMap.set(hName, lgName);
      }
    }
    
    const relatedL = (lg.data as any).relatedLimerick || [];
    for (const l of relatedL) {
      if (l.slug) {
        const lName = l.slug.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
        poemToLorelogMap.set(lName, lgName);
      }
    }

    const relatedE = (lg.data as any).relatedEntries || [];
    for (const re of relatedE) {
      if (re.id && ['haikus', 'limericks', 'aphorisms'].includes(re.collection)) {
        const pName = re.id.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
        poemToLorelogMap.set(pName, lgName);
      }
    }
  }
}

function getLabel(e: any): string {
  if (e.data.mascotId != null) return String(e.data.mascotId).padStart(3, '0');
  if (e.data.caseNumber) return e.data.caseNumber;
  if (e.data.versionLabel) return e.data.versionLabel;
  if (e.data.formNumber) return e.data.formNumber;
  return '—';
}

function getHref(e: any): string {
  if (collection === 'docs') {
    return '/' + e.id.replace(/\.mdx?$/, '');
  }
  if (collection === 'mascots') {
    return entryHref({ collection: 'mascots', id: e.id });
  }
  if (collection === 'lorelog') {
    return entryHref({ collection: 'lorelog', id: e.id });
  }
  if (collection === 'releases') {
    return entryHref({ collection: 'releases', id: e.id });
  }
  if (collection === 'changelog') {
    return entryHref({ collection: 'changelog', id: e.id });
  }
  
  const poemName = e.id.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
  
  if (poemToLorelogMap.has(poemName)) {
    return `/lorelog/${poemToLorelogMap.get(poemName)}#${poemName}`;
  }

  const parentRef = e.data.parentEntry ?? (e.data as any).relatedLorelog;
  if (parentRef) {
    const res = resolveExactAlias(String(parentRef), allEntries);
    if (res.resolved && res.entry) {
      return entryHref(res.entry, { anchor: poemName });
    }
  }
  
  const refs = [
    e.data.mascotRef,
    ...(e.data.relatedMascots || [])
  ].filter(Boolean);
  
  if (refs.length > 0) {
    for (const ref of refs) {
      const res = resolveExactAlias({ collection: 'mascots', id: String(ref) }, allEntries);
      if (res.resolved && res.entry) {
        return entryHref(res.entry, { anchor: poemName });
      }
    }
  }
  
  if (collection === 'haikus') return '/haikus#' + poemName;
  if (collection === 'limericks') return '/limericks#' + poemName;
  if (collection === 'aphorisms') return '/aphorisms#' + poemName;
  return '#';
}
---

{entries.length > 0 ? (
  <ul style="list-style:none;padding:0;margin:0;">
    {entries.map((e: any) => {
      const poemName = e.id.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
      return (
        <li id={poemName} style="display:flex;gap:1rem;padding:0.4rem 0;border-bottom:1px solid var(--sl-color-hairline);align-items:baseline;">
          <span style="font-family:var(--sl-font-mono);font-size:0.8rem;color:var(--sl-color-gray-3);min-width:6ch;flex-shrink:0;">
            {getLabel(e)}
          </span>
          <span style="flex:1;display:flex;flex-direction:column;gap:0.15rem;">
            <a href={getHref(e)}>{e.data.displayName ?? e.data.title}</a>
            {(e.data.cardDescription ?? e.data.tagline ?? e.data.description) && (
              <span style="font-size:0.75rem;color:var(--sl-color-gray-4);line-height:1.4;">
                {e.data.cardDescription ?? e.data.tagline ?? e.data.description}
              </span>
            )}
          </span>
          {e.data.completionState && (
            <span style="font-family:var(--sl-font-mono);font-size:0.7rem;color:var(--sl-color-gray-4);white-space:nowrap;text-transform:uppercase;align-self:flex-start;padding-top:0.1rem;">
              {e.data.completionState}
            </span>
          )}
        </li>
      );
    })}
  </ul>
) : (
  <p style="font-family:var(--sl-font-mono);font-size:0.8rem;color:var(--sl-color-gray-4);font-style:italic;padding:0.5rem 0;margin:0;">
    No entries filed in this register.
  </p>
)}

