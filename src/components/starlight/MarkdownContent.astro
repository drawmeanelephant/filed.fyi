---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { render } from 'astro:content';
import { getMatchingPoetry, getPoemId } from '../../lib/poetry-matcher';
import RelatedEntries from '../RelatedEntries.astro';

const entry = Astro.locals?.starlightRoute?.entry;
const {
  matchingHaikus,
  matchingLimericks,
  matchingAphorisms,
  isMascot,
} = await getMatchingPoetry(entry);

const relatedEntries = (entry?.data as any)?.relatedEntries;

// Default policy is 'inline'. Can be set to 'links' or 'none' via frontmatter.
const poetryDisplay = (entry?.data as any)?.poetryDisplay || 'inline';
const hasPoetry = matchingAphorisms.length > 0 || matchingHaikus.length > 0 || matchingLimericks.length > 0;
---

<Default {...Astro.props}>
  <slot />

  {relatedEntries && relatedEntries.length > 0 && (
    <RelatedEntries items={relatedEntries} />
  )}

  {poetryDisplay === 'inline' && hasPoetry && (
    <>
      {matchingAphorisms.length > 0 && (
        <div class="inline-poetry-section" style="margin-top: 3rem;">
          <h2 id="inline-aphorisms">{isMascot ? 'Aphorisms' : 'Related Aphorisms'}</h2>
          <div class="poetry-masonry-yard">
            {await Promise.all(matchingAphorisms.map(async (aphorism) => {
              const { Content } = await render(aphorism);
              return (
                <div id={getPoemId(aphorism)} class="inline-poem-wrapper">
                  <Content />
                </div>
              );
            }))}
          </div>
        </div>
      )}

      {matchingHaikus.length > 0 && (
        <div class="inline-poetry-section" style="margin-top: 3rem;">
          <h2 id="inline-haikus">{isMascot ? 'Haiku Log' : 'Related Haikus'}</h2>
          <div class="poetry-masonry-yard">
            {await Promise.all(matchingHaikus.map(async (haiku) => {
              const { Content } = await render(haiku);
              return (
                <div id={getPoemId(haiku)} class="inline-poem-wrapper">
                  <Content />
                </div>
              );
            }))}
          </div>
        </div>
      )}

      {matchingLimericks.length > 0 && (
        <div class="inline-poetry-section" style="margin-top: 3rem;">
          <h2 id="inline-limericks">{isMascot ? 'Limerick Log' : 'Related Limericks'}</h2>
          <div class="poetry-masonry-yard">
            {await Promise.all(matchingLimericks.map(async (limerick) => {
              const { Content } = await render(limerick);
              return (
                <div id={getPoemId(limerick)} class="inline-poem-wrapper">
                  <Content />
                </div>
              );
            }))}
          </div>
        </div>
      )}
    </>
  )}

  {poetryDisplay === 'links' && hasPoetry && (
    <section class="related-verse-section" style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--sl-color-hairline);">
      <h2 style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem; color: var(--sl-color-gray-2);">
        Related verse
      </h2>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem;">
        {matchingAphorisms.map((aphorism: any) => (
          <li style="padding: 0.25rem 0; border-bottom: 1px dashed var(--sl-color-hairline); display: flex; align-items: baseline; gap: 0.6rem;">
            <span style="font-family: var(--sl-font-mono); font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; min-width: 6ch; flex-shrink: 0;">Aphorism</span>
            <a href={`/aphorisms#${getPoemId(aphorism)}`} style="font-size: 0.875rem;">
              {aphorism.data?.title || aphorism.data?.caseNumber || aphorism.id}
            </a>
          </li>
        ))}
        {matchingHaikus.map((haiku: any) => (
          <li style="padding: 0.25rem 0; border-bottom: 1px dashed var(--sl-color-hairline); display: flex; align-items: baseline; gap: 0.6rem;">
            <span style="font-family: var(--sl-font-mono); font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; min-width: 6ch; flex-shrink: 0;">Haiku</span>
            <a href={`/haikus#${getPoemId(haiku)}`} style="font-size: 0.875rem;">
              {haiku.data?.title || haiku.data?.caseNumber || haiku.id}
            </a>
          </li>
        ))}
        {matchingLimericks.map((limerick: any) => (
          <li style="padding: 0.25rem 0; border-bottom: 1px dashed var(--sl-color-hairline); display: flex; align-items: baseline; gap: 0.6rem;">
            <span style="font-family: var(--sl-font-mono); font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; min-width: 6ch; flex-shrink: 0;">Limerick</span>
            <a href={`/limericks#${getPoemId(limerick)}`} style="font-size: 0.875rem;">
              {limerick.data?.title || limerick.data?.caseNumber || limerick.id}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Default>
