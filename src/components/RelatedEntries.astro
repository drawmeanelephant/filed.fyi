---
import { getCollection } from 'astro:content';
import { resolveExactAlias, entryHref, type ArchiveEntry, type ResolutionResult } from '../lib/archive-identity';

interface RelatedRef {
  collection: string;
  id: string;
  state?: string;
}

interface Props {
  items?: (RelatedRef | string)[];
}

const { items = [] } = Astro.props;

// Fetch all entries across collections to form the archive lookup index
const [mascots, lorelogs, docs, haikus, limericks, aphorisms] = await Promise.all([
  getCollection('mascots'),
  getCollection('lorelog'),
  getCollection('docs'),
  getCollection('haikus'),
  getCollection('limericks'),
  getCollection('aphorisms'),
]);

const allEntries: ArchiveEntry[] = [
  ...mascots.map((e) => ({ ...e, collection: 'mascots' })),
  ...lorelogs.map((e) => ({ ...e, collection: 'lorelog' })),
  ...docs.map((e) => ({ ...e, collection: 'docs' })),
  ...haikus.map((e) => ({ ...e, collection: 'haikus' })),
  ...limericks.map((e) => ({ ...e, collection: 'limericks' })),
  ...aphorisms.map((e) => ({ ...e, collection: 'aphorisms' })),
];

// Poem-to-Lorelog parent map
const poemToLorelogMap = new Map<string, string>();
for (const lg of lorelogs) {
  const lgName = lg.id.replace(/\.mdx?$/, '');

  const relatedH = (lg.data as any).relatedHaiku || [];
  for (const h of relatedH) {
    if (h.slug) {
      const hName = h.slug.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
      poemToLorelogMap.set(hName, lgName);
    }
  }

  const relatedL = (lg.data as any).relatedLimerick || [];
  for (const l of relatedL) {
    if (l.slug) {
      const lName = l.slug.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
      poemToLorelogMap.set(lName, lgName);
    }
  }

  const relatedE = (lg.data as any).relatedEntries || [];
  for (const re of relatedE) {
    if (re.id && ['haikus', 'limericks', 'aphorisms'].includes(re.collection)) {
      const pName = re.id.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
      poemToLorelogMap.set(pName, lgName);
    }
  }
}

const resolvedResults: (ResolutionResult & { state?: string })[] = items.map((rawItem) => {
  const state = typeof rawItem === 'object' ? (rawItem as any).state : undefined;
  const res = resolveExactAlias(rawItem, allEntries);

  if (res.resolved && res.entry) {
    const coll = res.entry.collection || res.collection;
    const isPoem = ['haikus', 'limericks', 'aphorisms'].includes(coll);
    let href = res.href || entryHref(res.entry);

    if (isPoem) {
      const poemName = res.entry.id.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase().trim() || '';
      if (poemToLorelogMap.has(poemName)) {
        href = `/lorelog/${poemToLorelogMap.get(poemName)}#${poemName}`;
      }
    }

    return { ...res, href, state };
  }

  return { ...res, state };
});
---

{resolvedResults.length > 0 && (
  <section style="margin-top:2rem;">
    <h2 style="font-size:0.9rem; text-transform:uppercase; letter-spacing:0.08em;">
      Related filings
    </h2>
    <ul style="list-style:none; padding:0; margin:0.5rem 0 0;">
      {resolvedResults.map((res) => (
        <li
          style="padding:0.35rem 0; border-bottom:1px solid var(--sl-color-hairline);"
        >
          {res.resolved && res.entry ? (
            <>
              <span
                style="font-family:var(--sl-font-mono); font-size:0.75rem; color:var(--sl-color-gray-3); margin-right:0.6rem;"
              >
                {res.entry.data?.caseNumber ?? res.entry.data?.mascotId ?? res.entry.data?.versionLabel ?? '—'}
              </span>
              <a href={res.href || '#'}>
                {res.entry.data?.displayName ?? res.entry.data?.title}
              </a>
            </>
          ) : (
            <span
              style="font-family:var(--sl-font-mono); font-size:0.75rem; color:var(--sl-color-gray-4); font-style:italic;"
            >
              UNRESOLVED · {res.collection} · {res.id}{res.state ? ` (${res.state})` : ''}
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>
)}

